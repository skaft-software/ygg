# syntax=docker/dockerfile:1.7
# Build with: docker build -f deploy/Dockerfile.ygg -t ygg:0.3.3-alpha .
FROM rust:1.86-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl
WORKDIR /src
COPY . .
RUN cargo build --locked --release --target x86_64-unknown-linux-musl -p ygg-coding-agent --bin ygg

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 ygg
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/ygg /usr/local/bin/ygg
USER ygg
WORKDIR /workspace
ENTRYPOINT ["ygg"]
