# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Build only from the clean tracked context produced by scripts/build-ygg-image.sh.
FROM --platform=linux/amd64 rust:1.86-bookworm@sha256:300ec56abce8cc9448ddea2172747d048ed902a3090e6b57babb2bf19f754081 AS build
ARG DEBIAN_SNAPSHOT=20260801T000000Z
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl
WORKDIR /src
COPY .ygg-container-source /tmp/ygg-container-source
RUN grep -Eq '^[0-9a-f]{40}$' /tmp/ygg-container-source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY extensions/ygg-serve ./extensions/ygg-serve
RUN cargo build --locked --release --target x86_64-unknown-linux-musl -p ygg-coding-agent --bins

FROM --platform=linux/amd64 debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ARG DEBIAN_SNAPSHOT=20260801T000000Z
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm-updates main" \
        "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 ygg
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/ygg /usr/local/bin/ygg
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/ygg-host /usr/local/bin/ygg-host
COPY README.md /usr/local/share/ygg/README.md
COPY docs /usr/local/share/ygg/docs
COPY examples /usr/local/share/ygg/examples
COPY sdk /usr/local/share/ygg/sdk
RUN test -f /usr/local/share/ygg/docs/sdk.md \
    && test -f /usr/local/share/ygg/examples/README.md \
    && test -f /usr/local/share/ygg/sdk/python/README.md
ENV YGG_PACKAGE_DIR=/usr/local/share/ygg
USER ygg
WORKDIR /workspace
ENTRYPOINT ["ygg"]
