#!/usr/bin/env python3
"""Self-contained launcher for the bundled ygg-ssh extension."""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent
# Release bundles vendor the exact dependency-free SDK revision used in tests.
sys.path.insert(0, str(ROOT / "vendor"))
sys.path.insert(0, str(ROOT))

from ygg_ssh.runtime import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
