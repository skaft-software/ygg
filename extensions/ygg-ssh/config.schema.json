{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygg.dev/extensions/ygg-ssh/config.schema.json",
  "title": "ygg-ssh configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": {"const": 1},
    "targets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias"],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 96},
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/",
          "description": "Optional absolute POSIX working-directory hint surfaced to the model."
        },
        "enabled": {"type": "boolean", "default": true}
      }
    }
  }
}
