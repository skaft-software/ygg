#!/usr/bin/env python3
"""Deterministic offline stand-in for the OpenSSH client.

Exits with $FAKE_SSH_EXIT (default 0) without touching a network so the
protocol smoke test can exercise /ssh connect end to end.
"""

import os
import sys

if __name__ == "__main__":
    sys.exit(int(os.environ.get("FAKE_SSH_EXIT", "0")))
