#!/usr/bin/env python3
"""Self-contained launcher for the bundled ygg-mcp extension."""

from pathlib import Path
import os
import sys


ROOT = Path(os.environ.get("YGG_EXTENSION_DIR", Path(__file__).resolve().parent)).resolve()
# Release bundles carry the exact dependency-free SDK wire implementation they
# were tested with. No install-time pip invocation or ambient site package is
# required.
sys.path.insert(0, str(ROOT / "vendor"))
sys.path.insert(0, str(ROOT))

from ygg_mcp.runtime import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
