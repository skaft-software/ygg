{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ygg-hermes-memory configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract", "environment"],
  "properties": {
    "version": {"const": 1},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hermesVersion", "commit"],
      "properties": {
        "hermesVersion": {"const": "0.20.1"},
        "commit": {"const": "7095e23eb2066fe9a2f93b99cdbfe0e2b5ece397"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "python", "hermesHome"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "python": {"type": "string", "minLength": 1, "maxLength": 4096},
        "hermesHome": {"type": "string", "minLength": 1, "maxLength": 4096},
        "providerEnvFile": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "includeEntryPoints": {"type": "boolean", "default": false}
      }
    },
    "directories": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/directory"},
      "default": []
    },
    "providerMetadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"$ref": "#/$defs/behavior"},
      "default": {}
    },
    "trustedProviders": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^(directory|entrypoint):[A-Za-z_][A-Za-z0-9_.-]{0,63}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "default": {}
    },
    "defaultProvider": {
      "type": ["string", "null"],
      "pattern": "^(directory|entrypoint):[A-Za-z_][A-Za-z0-9_.-]{0,63}$",
      "default": null
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxProviders": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxTools": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxQueryBytes": {"type": "integer", "minimum": 256, "maximum": 32768},
        "maxContextBytes": {"type": "integer", "minimum": 256, "maximum": 49152},
        "maxToolResultBytes": {"type": "integer", "minimum": 256, "maximum": 65536},
        "maxOwners": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxQueueDepth": {"type": "integer", "minimum": 1, "maximum": 64},
        "availabilityTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 5000},
        "initializeTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "prefetchTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "toolTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "syncTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "shutdownTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 5000}
      },
      "default": {}
    }
  },
  "$defs": {
    "toolNames": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"}
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "network": {"enum": ["none", "optional", "required", "unknown"]},
        "storage": {"enum": ["none", "local", "remote", "mixed", "unknown"]},
        "setup": {"enum": ["configured", "required", "unknown"]},
        "readTools": {"$ref": "#/$defs/toolNames"},
        "writeTools": {"$ref": "#/$defs/toolNames"}
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "network": {"enum": ["none", "optional", "required", "unknown"]},
        "storage": {"enum": ["none", "local", "remote", "mixed", "unknown"]},
        "setup": {"enum": ["configured", "required", "unknown"]},
        "readTools": {"$ref": "#/$defs/toolNames"},
        "writeTools": {"$ref": "#/$defs/toolNames"}
      }
    }
  }
}
