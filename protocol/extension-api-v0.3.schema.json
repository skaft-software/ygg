{
  "schema_format": "ygg.extension.protocol.schema/v1",
  "api_version": "0.3",
  "schema_id": "ygg.extension.api/0.3",
  "canonical_encoding": "ygg-canonical-json-v1",
  "legacy_adapters": [
    {
      "version": "0.1",
      "status": "frozen",
      "wire": "legacy-json-rpc"
    },
    {
      "version": "0.2",
      "status": "supported",
      "wire": "legacy-json-rpc"
    }
  ],
  "bounds": [
    {
      "name": "max_frame_bytes",
      "value": 1048576,
      "description": "Maximum UTF-8 JSON-RPC payload bytes, excluding the line delimiter.",
      "negotiated": true
    },
    {
      "name": "max_concurrent_requests",
      "value": 64,
      "description": "Maximum concurrently admitted host-to-extension requests.",
      "negotiated": true
    },
    {
      "name": "max_tools",
      "value": 256,
      "description": "Maximum complete tool catalog entries.",
      "negotiated": true
    },
    {
      "name": "max_capabilities",
      "value": 32,
      "description": "Maximum requested or selected capability names in one contract.",
      "negotiated": false
    },
    {
      "name": "max_methods",
      "value": 64,
      "description": "Maximum requested or selected method names in one contract.",
      "negotiated": false
    },
    {
      "name": "max_capability_name_bytes",
      "value": 64,
      "description": "Maximum UTF-8 bytes in one capability name.",
      "negotiated": false
    },
    {
      "name": "max_method_name_bytes",
      "value": 128,
      "description": "Maximum UTF-8 bytes in one method name.",
      "negotiated": false
    },
    {
      "name": "max_reason_bytes",
      "value": 4096,
      "description": "Maximum UTF-8 bytes in an inspectable disposition reason.",
      "negotiated": false
    },
    {
      "name": "max_json_depth",
      "value": 32,
      "description": "Maximum nested JSON container depth for canonical protocol values.",
      "negotiated": false
    },
    {
      "name": "max_portable_json_integer",
      "value": 9007199254740991,
      "description": "Largest exactly portable JSON integer accepted by canonical encoding.",
      "negotiated": false
    },
    {
      "name": "max_content_parts",
      "value": 256,
      "description": "Maximum ordered API 0.3 tool-result content parts.",
      "negotiated": false
    },
    {
      "name": "max_tool_name_bytes",
      "value": 128,
      "description": "Maximum UTF-8 bytes in an API 0.3 tool name.",
      "negotiated": false
    },
    {
      "name": "max_tool_description_bytes",
      "value": 4096,
      "description": "Maximum UTF-8 bytes in an API 0.3 tool description.",
      "negotiated": false
    },
    {
      "name": "max_json_rpc_id_bytes",
      "value": 256,
      "description": "Maximum UTF-8 bytes in a string JSON-RPC identifier.",
      "negotiated": false
    }
  ],
  "capabilities": [
    {
      "name": "content_parts",
      "description": "Typed text/media tool-result parts and structured result details.",
      "host_offer": "required",
      "status": "foundation"
    },
    {
      "name": "core",
      "description": "Versioned initialization, explicit errors, bounds, and canonical encoding.",
      "host_offer": "required",
      "status": "foundation"
    },
    {
      "name": "dynamic_tools",
      "description": "Live transactional tool-catalog mutation.",
      "host_offer": "unavailable",
      "status": "deferred"
    },
    {
      "name": "lifecycle_events",
      "description": "Host lifecycle observations for extension cleanup.",
      "host_offer": "unavailable",
      "status": "deferred"
    },
    {
      "name": "request_cancellation",
      "description": "Cooperative cancellation with explicit terminal disposition.",
      "host_offer": "required",
      "status": "foundation"
    },
    {
      "name": "tool_call",
      "description": "Bounded host-to-extension model tool invocation.",
      "host_offer": "required",
      "status": "foundation"
    }
  ],
  "methods": [
    {
      "name": "$/cancelRequest",
      "direction": "bidirectional",
      "capability": "request_cancellation",
      "host_offer": "required",
      "status": "foundation",
      "params": "CancelRequestParams",
      "result": "CancelRequestResult",
      "terminal": "original_request_cancelled",
      "notification": true
    },
    {
      "name": "context/collect",
      "direction": "host_to_extension",
      "capability": "lifecycle_events",
      "host_offer": "unavailable",
      "status": "deferred",
      "params": null,
      "result": null,
      "terminal": "deferred",
      "notification": false
    },
    {
      "name": "hook/run",
      "direction": "host_to_extension",
      "capability": "lifecycle_events",
      "host_offer": "unavailable",
      "status": "deferred",
      "params": null,
      "result": null,
      "terminal": "deferred",
      "notification": false
    },
    {
      "name": "initialize",
      "direction": "host_to_extension",
      "capability": "core",
      "host_offer": "required",
      "status": "foundation",
      "params": "InitializeRequest",
      "result": "InitializeResponse",
      "terminal": "initialized",
      "notification": false
    },
    {
      "name": "shutdown",
      "direction": "host_to_extension",
      "capability": "core",
      "host_offer": "required",
      "status": "foundation",
      "params": "ShutdownParams",
      "result": "ShutdownResult",
      "terminal": "shutdown",
      "notification": false
    },
    {
      "name": "tool/call",
      "direction": "host_to_extension",
      "capability": "tool_call",
      "host_offer": "required",
      "status": "foundation",
      "params": "ToolCallParams",
      "result": "ToolCallResult",
      "terminal": "result_or_error",
      "notification": false
    },
    {
      "name": "tools/register",
      "direction": "extension_to_host",
      "capability": "dynamic_tools",
      "host_offer": "unavailable",
      "status": "deferred",
      "params": null,
      "result": null,
      "terminal": "deferred",
      "notification": false
    },
    {
      "name": "tools/unregister",
      "direction": "extension_to_host",
      "capability": "dynamic_tools",
      "host_offer": "unavailable",
      "status": "deferred",
      "params": null,
      "result": null,
      "terminal": "deferred",
      "notification": false
    }
  ],
  "errors": [
    {
      "name": "parse_error",
      "code": -32700,
      "message": "parse error",
      "description": "Invalid JSON was received."
    },
    {
      "name": "invalid_request",
      "code": -32600,
      "message": "invalid request",
      "description": "The JSON-RPC envelope is invalid."
    },
    {
      "name": "unknown_method",
      "code": -32601,
      "message": "unknown or unnegotiated method",
      "description": "The method is absent from the negotiated API 0.3 contract."
    },
    {
      "name": "invalid_params",
      "code": -32602,
      "message": "invalid params",
      "description": "Parameters violate a canonical wire type or bound."
    },
    {
      "name": "internal_error",
      "code": -32603,
      "message": "internal error",
      "description": "The implementation could not complete a valid request."
    },
    {
      "name": "version_mismatch",
      "code": -32010,
      "message": "extension API version mismatch",
      "description": "The peer did not select exactly API 0.3 and this wire cannot be adapted."
    },
    {
      "name": "capability_mismatch",
      "code": -32011,
      "message": "extension capability mismatch",
      "description": "A required capability or method is missing, duplicated, unknown, or not offered."
    },
    {
      "name": "resource_exhausted",
      "code": -32012,
      "message": "extension resource exhausted",
      "description": "A declared aggregate or per-contract bound was exhausted."
    },
    {
      "name": "request_cancelled",
      "code": -32800,
      "message": "request cancelled",
      "description": "Cooperative cancellation won the terminal race."
    }
  ],
  "dispositions": [
    {
      "name": "continue",
      "requires_reason": false,
      "description": "Continue the operation without a veto."
    },
    {
      "name": "deny",
      "requires_reason": true,
      "description": "Deny an interceptable operation with an inspectable reason."
    },
    {
      "name": "defer",
      "requires_reason": true,
      "description": "Defer a supported operation until a host-owned boundary resolves."
    }
  ],
  "models": [
    {
      "name": "ProtocolLimits",
      "description": "Negotiated maxima selected by the extension and capped by the host.",
      "fields": [
        {
          "name": "max_frame_bytes",
          "type": "integer",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "max_concurrent_requests",
          "type": "integer",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "max_tools",
          "type": "integer",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "ContractOffer",
      "description": "Host offer for the API 0.3 capability and method contract.",
      "fields": [
        {
          "name": "schema",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "encoding",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "required_capabilities",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_capabilities"
        },
        {
          "name": "optional_capabilities",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_capabilities"
        },
        {
          "name": "required_methods",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_methods"
        },
        {
          "name": "optional_methods",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_methods"
        },
        {
          "name": "limits",
          "type": "ProtocolLimits",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "ContractSelection",
      "description": "Extension selection from one API 0.3 contract offer.",
      "fields": [
        {
          "name": "schema",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "encoding",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "capabilities",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_capabilities"
        },
        {
          "name": "methods",
          "type": "string[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_methods"
        },
        {
          "name": "limits",
          "type": "ProtocolLimits",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "ToolDefinition",
      "description": "A complete API 0.3 model tool definition returned at initialization.",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "max_bytes": "max_tool_name_bytes"
        },
        {
          "name": "description",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "max_bytes": "max_tool_description_bytes"
        },
        {
          "name": "parameters",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "output_schema",
          "type": "json",
          "presence": "optional",
          "nullable": false
        }
      ]
    },
    {
      "name": "ContentPart",
      "description": "One ordered, typed API 0.3 tool-result content part.",
      "kind": "tagged_union",
      "tag": "type",
      "variants": [
        {
          "name": "Text",
          "wire": "text",
          "fields": [
            {
              "name": "text",
              "type": "string",
              "presence": "required",
              "nullable": false
            }
          ]
        },
        {
          "name": "Image",
          "wire": "image",
          "status": "deferred",
          "fields": [
            {
              "name": "artifact_id",
              "type": "string",
              "presence": "required",
              "nullable": false,
              "max_bytes": "max_json_rpc_id_bytes"
            },
            {
              "name": "mime_type",
              "type": "string",
              "presence": "required",
              "nullable": false,
              "max_bytes": "max_method_name_bytes"
            },
            {
              "name": "alt",
              "type": "string",
              "presence": "optional",
              "nullable": false
            }
          ]
        },
        {
          "name": "Audio",
          "wire": "audio",
          "status": "deferred",
          "fields": [
            {
              "name": "artifact_id",
              "type": "string",
              "presence": "required",
              "nullable": false,
              "max_bytes": "max_json_rpc_id_bytes"
            },
            {
              "name": "mime_type",
              "type": "string",
              "presence": "required",
              "nullable": false,
              "max_bytes": "max_method_name_bytes"
            },
            {
              "name": "transcript",
              "type": "string",
              "presence": "optional",
              "nullable": false
            }
          ]
        }
      ]
    },
    {
      "name": "ToolCallParams",
      "description": "Host-to-extension bounded API 0.3 tool invocation parameters.",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "max_bytes": "max_tool_name_bytes"
        },
        {
          "name": "arguments",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "context",
          "type": "json",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "ToolCallResult",
      "description": "Terminal successful API 0.3 tool-call result; failures use the generated JSON-RPC error envelope.",
      "fields": [
        {
          "name": "content",
          "type": "ContentPart[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_content_parts"
        },
        {
          "name": "is_error",
          "type": "boolean",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "metadata",
          "type": "json",
          "presence": "required",
          "nullable": true
        },
        {
          "name": "structured_content",
          "type": "json",
          "presence": "optional",
          "nullable": true
        }
      ]
    },
    {
      "name": "CancelRequestParams",
      "description": "Idempotent cancellation notification parameters for an active request.",
      "fields": [
        {
          "name": "id",
          "type": "rpc_id",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "reason",
          "type": "string",
          "presence": "optional",
          "nullable": false,
          "max_bytes": "max_reason_bytes"
        }
      ]
    },
    {
      "name": "CancelRequestResult",
      "description": "The terminal cancellation fact attached to the original request outcome.",
      "fields": [
        {
          "name": "terminal",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "cancelled"
          ]
        },
        {
          "name": "reason",
          "type": "string",
          "presence": "optional",
          "nullable": false,
          "max_bytes": "max_reason_bytes"
        }
      ]
    },
    {
      "name": "ShutdownParams",
      "description": "Empty graceful-shutdown parameters; unknown fields are rejected.",
      "fields": []
    },
    {
      "name": "ShutdownResult",
      "description": "Terminal graceful-shutdown acknowledgement.",
      "fields": [
        {
          "name": "terminal",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "shutdown"
          ]
        }
      ]
    },
    {
      "name": "InitializeRequest",
      "description": "Canonical API 0.3 initialize parameters. Host-owned metadata values remain explicitly opaque JSON boundaries.",
      "fields": [
        {
          "name": "api_version",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "0.3"
          ]
        },
        {
          "name": "ygg_version",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "extension",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "workspace",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "capabilities",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "contributes",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "host",
          "type": "json",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "contract",
          "type": "ContractOffer",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "InitializeResponse",
      "description": "Canonical API 0.3 initialize result with the complete selected tool catalog.",
      "fields": [
        {
          "name": "api_version",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "0.3"
          ]
        },
        {
          "name": "tools",
          "type": "ToolDefinition[]",
          "presence": "required",
          "nullable": false,
          "max_items": "max_tools"
        },
        {
          "name": "contract",
          "type": "ContractSelection",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "ErrorObject",
      "description": "Bounded JSON-RPC error object using an API 0.3 error-table code. Its data field preserves absent versus explicit null.",
      "fields": [
        {
          "name": "code",
          "type": "signed_integer",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "message",
          "type": "string",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "data",
          "type": "json",
          "presence": "optional",
          "nullable": true
        }
      ]
    },
    {
      "name": "Disposition",
      "description": "Explicit API 0.3 operation disposition. Reason is optional but never nullable when present.",
      "fields": [
        {
          "name": "kind",
          "type": "disposition",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "reason",
          "type": "string",
          "presence": "optional",
          "nullable": false,
          "max_bytes": "max_reason_bytes"
        }
      ]
    },
    {
      "name": "JsonRpcRequest",
      "description": "Strict JSON-RPC 2.0 request envelope.",
      "fields": [
        {
          "name": "jsonrpc",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "2.0"
          ]
        },
        {
          "name": "id",
          "type": "rpc_id",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "method",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "max_bytes": "max_method_name_bytes"
        },
        {
          "name": "params",
          "type": "json",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "JsonRpcNotification",
      "description": "Strict JSON-RPC 2.0 notification envelope.",
      "fields": [
        {
          "name": "jsonrpc",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "2.0"
          ]
        },
        {
          "name": "method",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "max_bytes": "max_method_name_bytes"
        },
        {
          "name": "params",
          "type": "json",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "JsonRpcSuccessResponse",
      "description": "Strict JSON-RPC 2.0 successful response envelope.",
      "fields": [
        {
          "name": "jsonrpc",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "2.0"
          ]
        },
        {
          "name": "id",
          "type": "rpc_id",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "result",
          "type": "json",
          "presence": "required",
          "nullable": false
        }
      ]
    },
    {
      "name": "JsonRpcErrorResponse",
      "description": "Strict JSON-RPC 2.0 error response envelope.",
      "fields": [
        {
          "name": "jsonrpc",
          "type": "string",
          "presence": "required",
          "nullable": false,
          "values": [
            "2.0"
          ]
        },
        {
          "name": "id",
          "type": "rpc_id",
          "presence": "required",
          "nullable": false
        },
        {
          "name": "error",
          "type": "ErrorObject",
          "presence": "required",
